# CleanSpace — LiteSpeed/Apache rules for the prerendered site.
#
# The build emits one folder per locale/route (/ar/download/index.html …), plus
# index.csr.html as the client-rendered shell.
#
#   1. the bare root 301s to the visitor's language, from Accept-Language
#   2. a prefixed URL returns its prerendered file at 200, with no redirect chain
#   3. anything unknown falls back to the shell and routes client-side

# This file must never be downloadable. Most hosts deny .ht* globally, but that
# isn't guaranteed, and the rules below describe the site's layout.
<FilesMatch "^\.ht">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_dir.c>
  # Without this, mod_dir 301s /ar/download to /ar/download/ before the rewrite
  # below can answer it — a redirect chain on every single page. Off means the
  # directory's index.html is served straight at the URL that was requested.
  DirectorySlash Off
  DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 1. Bare root → /<lang>/ ------------------------------------------------
  # Chinese and Portuguese first: their folder names (zh-Hans, zh-Hant, pt-BR) aren't just
  # the primary subtag, so they can't come from the generic capture below.
  RewriteCond %{HTTP:Accept-Language} ^zh-(?:TW|HK|Hant) [NC]
  RewriteRule ^$ /zh-Hant/ [R=301,L]

  RewriteCond %{HTTP:Accept-Language} ^zh [NC]
  RewriteRule ^$ /zh-Hans/ [R=301,L]

  RewriteCond %{HTTP:Accept-Language} ^pt [NC]
  RewriteRule ^$ /pt-BR/ [R=301,L]

  # The other 18 locales, where the folder name *is* the primary subtag, so the
  # captured %1 can be reused directly. The trailing (?![a-z]) stops 'ar' from
  # matching 'arn' and friends.
  # Deliberately no [NC]: %1 becomes a directory name, and it must keep the
  # lower-case form the folders use. Browsers send lower-case subtags; anything
  # unusual just falls through to English below, which is a safe outcome.
  RewriteCond %{HTTP:Accept-Language} ^(ar|ckb|de|en|es|fa|fr|hi|id|it|ja|ko|nl|pl|ru|tr|ur|vi)(?![a-z])
  RewriteRule ^$ /%1/ [R=301,L]

  # Everything else → English.
  RewriteRule ^$ /en/ [R=301,L]

  # --- 2. Serve the prerendered file ------------------------------------------
  # Real files are served as-is. Directories deliberately are NOT matched here:
  # letting one through hands it to mod_dir, which 301s /ar/download to
  # /ar/download/ — a redirect chain on every page. The next rule serves the
  # directory's index.html directly instead, at 200.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /ar/download → /ar/download/index.html, with or without a trailing slash.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # --- 3. Unknown URL → the client-rendered shell -------------------------------
  # index.html is the shell, copied from index.csr.html by scripts/root-index.mjs.
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # HTML must never be cached: a stale shell would pin visitors to an old bundle.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Hashed assets never change under the same name.
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
